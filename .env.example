WEB_DOMAIN=ediary.corevanta.app
API_DOMAIN=ediary-api.corevanta.app

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Mongo from ../infrastructure (defaults shown)
MONGO_HOST=mongo:27017
MONGO_USER=super
MONGO_PASSWORD=secret
MONGO_OPTIONS=retryWrites=false&authSource=admin&appName=e-diary
